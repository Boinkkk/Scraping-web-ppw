  {
   "cell_type": "markdown",
   "id": "92f2d473",
   "metadata": {},
   "source": [
    "### Cek Duplikasi"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 61,
   "id": "98d0880c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Detik Sport   -> Duplikat Judul: 0, Duplikat Isi: 0, Keduanya: 0\n",
      "Detik Finance -> Duplikat Judul: 0, Duplikat Isi: 0, Keduanya: 0\n"
     ]
    }
   ],
   "source": [
    "dup_sport_judul = df_sport['judul'].duplicated().sum()\n",
    "dup_sport_isi = df_sport['isi_berita'].duplicated().sum()\n",
    "dup_sport_keduanya = df_sport.duplicated(subset=['judul', 'isi_berita']).sum()\n",
    "\n",
    "dup_finance_judul = df_finance['judul'].duplicated().sum()\n",
    "dup_finance_isi = df_finance['isi_berita'].duplicated().sum()\n",
    "dup_finance_keduanya = df_finance.duplicated(subset=['judul', 'isi_berita']).sum()\n",
    "\n",
    "print(f\"Detik Sport   -> Duplikat Judul: {dup_sport_judul}, Duplikat Isi: {dup_sport_isi}, Keduanya: {dup_sport_keduanya}\")\n",
    "print(f\"Detik Finance -> Duplikat Judul: {dup_finance_judul}, Duplikat Isi: {dup_finance_isi}, Keduanya: {dup_finance_keduanya}\")"
   ]
  },
