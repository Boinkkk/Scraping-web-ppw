  {
   "cell_type": "markdown",
   "id": "ebd059d1",
   "metadata": {},
   "source": [
    "### Stopword Removal Dan Stemming"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 68,
   "id": "5b683892",
   "metadata": {},
   "outputs": [],
   "source": [
    "from Sastrawi.StopWordRemover.StopWordRemoverFactory import StopWordRemoverFactory\n",
    "from Sastrawi.Stemmer.StemmerFactory import StemmerFactory\n",
    "\n",
    "stop_factory = StopWordRemoverFactory()\n",
    "stopword_remover = stop_factory.create_stop_word_remover()\n",
    "stem_factory = StemmerFactory()\n",
    "stemmer = stem_factory.create_stemmer()\n",
    "\n",
    "\n",
    "def stopword_removal_stemming(text):\n",
    "    text = stopword_remover.remove(text)\n",
    "    text = stemmer.stem(text)\n",
    "    return text"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 74,
   "id": "f5c46f4b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "File 'data_berita_processed.csv' ditemukan. Proses dilewati.\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "file_path = Path(\"data_berita_processed.csv\")\n",
    "\n",
    "if file_path.is_file():\n",
    "    print(f\"File '{file_path}' ditemukan. Proses dilewati.\")\n",
    "    df = pd.read_csv(file_path)\n",
    "else:\n",
    "    print(\"Menjalankan pipeline pemrosesan...\")\n",
    "    df[\"isi_berita\"] = df[\"isi_berita\"].apply(stopword_removal_stemming)\n",
    "    df.to_csv(file_path, index=False, encoding=\"utf-8-sig\")\n",
    "    display(df)\n"
   ]
  },
