   "source": [
    "import re\n",
    "def clean_news_text(text):\n",
    "    # Hapus tag [Gambas:...] dan baris \"Lihat juga\" / \"Baca juga\"\n",
    "    text = re.sub(r\"\\[Gambas:.*?\\]\", \"\", text)\n",
    "    text = re.sub(r\"(Lihat juga Video:|Baca juga:).*?(\\n|$)\", \"\", text)\n",
    "    text = re.sub(r\"^[A-Z\\s]+-\\s*\", \"\", text)  # Hapus prefix kota seperti \"Jakarta - \"\n",
    "    text = re.sub(r\"detikcom|detikSport|detikFinance\", \"\", text, flags=re.IGNORECASE)\n",
    "    # Case folding & Hapus simbol/angka\n",
    "    text = text.lower()\n",
    "    text = re.sub(r\"[^a-z\\s]\", \" \", text)\n",
    "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
    "    return text\n",
    "    \n",
    "df[\"isi_berita\"] = df[\"isi_berita\"].apply(clean_news_text)\n",
    "df"
   ]
  },
