   "source": [
    "def cek_data_kosong(df, nama_df=\"DataFrame\"):\n",
    "    hasil = []\n",
    "    for col in df.columns:\n",
    "        null_count = df[col].isna().sum()\n",
    "        if df[col].dtype == 'object':\n",
    "            empty_string_count = (df[col].fillna('').astype(str).str.strip() == '').sum() - null_count\n",
    "        else:\n",
    "            empty_string_count = 0\n",
    "        \n",
    "        total_kosong = null_count + empty_string_count\n",
    "        persentase = (total_kosong / len(df)) * 100\n",
    "        \n",
    "        hasil.append({\n",
    "            'Kolom': col,\n",
    "            'NaN / None': null_count,\n",
    "            'String Kosong': empty_string_count,\n",
    "            'Total Kosong': total_kosong,\n",
    "            'Persentase (%)': round(persentase, 2)\n",
    "        })\n",
    "    \n",
    "    import pandas as pd\n",
    "    print(f\"=== Ringkasan Data Kosong: {nama_df} ===\")\n",
    "    return pd.DataFrame(hasil)\n",
    "\n",
    "display(cek_data_kosong(df_sport, \"Detik Sport\"))\n",
    "display(cek_data_kosong(df_finance, \"Detik Finance\"))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 59,
   "id": "f6440528",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "df_sport = (\n",
    "    df_sport.replace(r'^\\s*$', np.nan, regex=True)\n",
    "    .dropna(subset=['judul', 'isi_berita'])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "df_finance = (\n",
    "    df_finance.replace(r'^\\s*$', np.nan, regex=True)\n",
    "    .dropna(subset=['judul', 'isi_berita'])\n",
    "    .reset_index(drop=True)\n",
    ")"
   ]
  },
