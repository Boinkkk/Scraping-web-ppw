    "df_sport_100 = df_sport.loc[df_sport['isi_berita'].str.split().str.len().nlargest(100).index].reset_index(drop=True)\n",
    "df_finance_100 = df_finance.loc[df_finance['isi_berita'].str.split().str.len().nlargest(100).index].reset_index(drop=True)\n",
