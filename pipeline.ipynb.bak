   "source": [
    "from sklearn.decomposition import PCA\n",
    "\n",
    "pca = PCA(n_components=100, random_state=42)\n",
    "pca_result = pca.fit_transform(df_tfidf)\n",
    "\n",
    "kolom_pc = [f\"PC{i+1}\" for i in range(100)]\n",
    "df_pca = pd.DataFrame(pca_result, columns=kolom_pc)\n",
    "\n",
    "display(df_pca)\n",
    "\n"
   ]
  },
