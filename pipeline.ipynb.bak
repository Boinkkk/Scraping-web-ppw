     ]
    }
   ],
   "source": [
    "total_varians = pca.explained_variance_ratio_.sum() * 100\n",
    "print(f\"Bentuk data awal : {df_tfidf.shape}\")\n",
    "print(f\"Bentuk data PCA  : {pca_result.shape}\")\n",
    "print(f\"Total informasi (varians) yang dipertahankan: {total_varians:.2f}%\")"
   ]
  },
