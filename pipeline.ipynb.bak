   "id": "1457239b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total seluruh kata : 524,129\n",
      "Total kata unik    : 6,486\n"
     ]
    }
   ],
   "source": [
    "def check_total_word(df):\n",
    "    semua_kata = df['isi_berita'].astype(str).str.lower().str.cat(sep=' ')\n",
    "    kata_unik = set(re.findall(r'(?u)\\b\\w\\w+\\b',semua_kata))\n",
    "\n",
    "    print(f\"Total seluruh kata : {len(semua_kata):,}\")\n",
    "    print(f\"Total kata unik    : {len(kata_unik):,}\")\n",
    "    \n",
    "check_total_word(df)"
   ]
  },
